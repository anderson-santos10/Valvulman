# Copie este arquivo para .env e ajuste os valores.
# Nunca versionar o arquivo .env.

DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# URL pública usada no QR Code do certificado (sem barra no final).
# Em produção: https://seu-dominio
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Em produção (DEBUG=False), SECRET_KEY é obrigatória.
# Railway (exemplo):
# DEBUG=False
# ALLOWED_HOSTS=valvulman-production.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://valvulman-production.up.railway.app
# PUBLIC_BASE_URL=https://valvulman-production.up.railway.app
# SECURE_SSL_REDIRECT=True
