# Copie este arquivo para .env e ajuste os valores.
# Nunca versionar o arquivo .env nem SECRET_KEY/DATABASE_URL reais.

DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# URL pública usada no QR Code do certificado (sem barra no final).
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Sem DATABASE_URL o Django usa SQLite (db.sqlite3) — adequado ao desenvolvimento.
# No Railway, deixe o PostgreSQL injetar DATABASE_URL. Não versionar o valor.
DATABASE_URL=

# Em produção (DEBUG=False), SECRET_KEY é obrigatória.
# Railway (exemplo — preencha no painel, não no Git):
# DEBUG=False
# ALLOWED_HOSTS=valvulman-production.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://valvulman-production.up.railway.app
# PUBLIC_BASE_URL=https://valvulman-production.up.railway.app
# DATABASE_URL=  # vem do serviço PostgreSQL
# SECURE_SSL_REDIRECT=True
